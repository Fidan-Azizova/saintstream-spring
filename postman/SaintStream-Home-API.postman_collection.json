          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Standart format: success, message, data\", () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys(\"success\",\"message\",\"data\"); });",
              "pm.test(\"1–5 element, genres massiv\", () => { const d = pm.response.json().data; pm.expect(d.length).to.be.within(1,5); pm.expect(d[0].genres).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
