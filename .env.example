# Bu faylı .env adı ilə kopyala və öz dəyərlərini yaz. .env GitHub-a getmir.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saintstream
DB_USER=saintstream
DB_PASSWORD=saintstream
PORT=5000

# İcazə verilən frontend origin-ləri (vergüllə). Vercel domenini real ünvanla əvəz et.
CORS_ORIGINS=http://localhost:3000,https://saintstream.vercel.app
